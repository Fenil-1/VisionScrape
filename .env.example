# No API key needed if you use Google login (Application Default Credentials):
#   gcloud auth application-default login
#   gcloud config set project YOUR_PROJECT_ID
# Optionally override the project used for Vertex AI:
GOOGLE_CLOUD_PROJECT=

# — OR — copy this file to .env.local and fill in ONE of the keys below.

# Option A — Google AI Studio key (free tier available): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Option B — Vertex AI express key (same as the OCR-main reference project)
VERTEX_API_KEY=
